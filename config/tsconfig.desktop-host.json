{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "../src/desktop-host/**/*.ts",
    "../src/shared/**/*.ts",
    "../src/main/runtime/rpc/e2ee-channel.ts",
    "../src/main/runtime/rpc/e2ee-crypto.ts"
  ],
  "exclude": ["../src/desktop-host/**/*.test.ts", "../src/shared/**/*.test.ts"]
}
